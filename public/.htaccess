# VConnect Holidays: static React build on HostingRaja (LiteSpeed reads Apache rules).
# Copied into dist/ by Vite. Upload it together with the rest of dist/.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical address: https, no www.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2. Old WordPress URLs. /about/, /tour-packages/ and /contact/ exist as-is.
  RewriteRule ^destination/?$ /destinations/ [L,R=301]
  RewriteRule ^faq/?$ /#faq [L,R=301,NE]
  RewriteRule ^blog/?$ / [L,R=301]
  # Gone for good (410): template leftovers and WordPress endpoints bots keep probing.
  RewriteRule ^(sample-page|jkit-header|jkit-footer|category|author|tag|feed|comments|wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-config)\.php$ - [G,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/ - [G,L]

  # 3. Pages are folders with index.html, so /about redirects to /about/ (matches canonicals).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # 4. Anything else the app can still handle (search, unknown slugs): the noindex shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /__spa-fallback.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change; HTML must always be re-checked.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Staging copy (new.vconnectholidays.com) stays out of search results.
  SetEnvIf Host "^new\." STAGING
  Header set X-Robots-Tag "noindex, nofollow" env=STAGING

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
